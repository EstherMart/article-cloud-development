# Copie para .env e preencha. Nunca commite o .env.
DJANGO_SECRET_KEY=troque-isto
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=

# RDS (deixe DB_HOST vazio para usar SQLite local)
DB_HOST=
DB_NAME=academichub
DB_USER=postgres
DB_PASSWORD=
DB_PORT=5432
DB_SSLMODE=require

# AWS (na EC2 use a IAM Role, sem chaves)
AWS_REGION=us-east-1
S3_BUCKET=
SNS_TOPIC_ARN=
SQS_QUEUE_URL=
DYNAMODB_TABLE=logs_crud
REDIS_URL=

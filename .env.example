# Copie para .env e preencha. Nunca commite o .env.
DJANGO_SECRET_KEY=troque-isto   # obrigatória quando DJANGO_DEBUG=False
DJANGO_DEBUG=True
# Na EC2/ALB: DNS do ALB e IP privado da instância (o health check chega com o IP). Vírgula entre os valores
DJANGO_ALLOWED_HOSTS=backend,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

FRONT_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080/api

# RDS (deixe DB_HOST vazio para usar SQLite local)
DB_NAME=artigos
DB_USER=
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432
# O Postgres do compose não tem TLS; o worker usa "require" por padrão e falharia ao conectar.
DB_SSLMODE=disable

POSTGRES_DB=artigos
POSTGRES_USER=
POSTGRES_PASSWORD=


SEED_DEMO_DATA=
DEMO_USER_PASSWORD=

AWS_REGION=us-east-1
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=artigos
MINIO_REGION=us-east-1
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_PUBLIC_ENDPOINT_URL=http://localhost:9000 

# Fila de mensagens (RabbitMQ). Usuário e senha criam o login do broker no compose; preencha os dois.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
RABBITMQ_QUEUE=artigos.criados
# Worker: tradução com Gemini (nunca versione a chave)
GEMINI_API_KEY=
GEMINI_MODEL=
DYNAMODB_TABLE=logs_crud
REDIS_URL=redis://redis:6379/0

# Só para os testes de integração (opcionais; ver articles/tests/integration/README.md)
# RDS_INSTANCE_ID=artigos-rds
# ELASTICACHE_ID=artigos-redis
# FRONT_URL=http://<bucket-do-site>.s3-website-us-east-1.amazonaws.com
# ASG_NAME=
# ALB_NAME=
# API_BASE_URL=http://<ip-da-ec2>:8000
